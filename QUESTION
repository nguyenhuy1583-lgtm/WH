    function renderBuilder() {
      const q = document.getElementById('bQ').value;
      const a = document.getElementById('bA').value;
      const s = document.getElementById('bS').value;
      const [vText, vType] = document.getElementById('bV').value.split('|');

      const sentence = (q ? q + ' ' : '') + a + ' ' + s + ' ' + vText + '?';
      const capSent = sentence.charAt(0).toUpperCase() + sentence.slice(1);
      const errors = [];
      const is3rd = (s === 'he' || s === 'she' || s === 'it' || s === 'your friend' || s === 'the meeting');
      const isBe = ['am', 'is', 'are', 'was', 'were'].includes(a);
      const isModal = ['can', 'could', 'will', 'should'].includes(a);

      if (vType === 'action' && isBe) {
        errors.push(`"${vText}" là động từ hành động → phải dùng do/does/did hoặc can/could/will/should, KHÔNG dùng "${a}".`);
      }
      if (vType === 'state' && !isBe) {
        errors.push(`"${vText}" là tính từ/nơi chốn → phải dùng To Be (am/is/are/was/were), KHÔNG dùng "${a}" đứng một mình (nếu dùng ${a} phải thêm "be", vd: "${a} ${s} be ${vText}?").`);
      }
      if (a === 'does' && !is3rd) errors.push(`Chủ ngữ "${s}" phải đi với "do", không dùng "does".`);
      if (a === 'do' && is3rd) errors.push(`Chủ ngữ "${s}" (ngôi 3 số ít) phải đi với "does", không dùng "do".`);
      if (a === 'am' && s !== 'I') errors.push(`"am" chỉ đi với chủ ngữ "I".`);
      if (a === 'is' && !is3rd) errors.push(`Chủ ngữ "${s}" không đi với "is" (dùng "are" cho you/we/they, "am" cho I).`);
      if (a === 'are' && (is3rd || s === 'I')) errors.push(`Chủ ngữ "${s}" không đi với "are".`);
      if (a === 'was' && !(is3rd || s === 'I')) errors.push(`Chủ ngữ "${s}" ở quá khứ phải dùng "were", không dùng "was".`);
      if (a === 'were' && (is3rd || s === 'I')) errors.push(`Chủ ngữ "${s}" ở quá khứ phải dùng "was", không dùng "were".`);
      if (q === 'What' && vText === 'like coffee') errors.push(`Đã có "coffee" sau "like" nên không dùng "What" ở đầu (dùng Yes/No: "Do you like coffee?").`);
      if (q === 'What' && vText === 'from Vietnam') errors.push(`Hỏi quê quán bỏ "Vietnam" và dùng "Where are you from?".`);

      const box = document.getElementById('builderResult');
      if (!errors.length) {
        box.className = 'rounded-2xl p-4 border bg-emerald-50 border-emerald-300 space-y-2';
        box.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <div class="text-xs font-extrabold text-emerald-700">✅ CHUẨN NGỮ PHÁP 100%!</div>
              <div class="text-lg font-extrabold text-slate-900 mt-0.5">${esc(capSent)}</div>
            </div>
            <button data-speak-text="${esc(capSent)}" data-speak-rate="0.9" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold">🔊 Nghe câu vừa ghép</button>
          </div>
        `;
      } else {
        box.className = 'rounded-2xl p-4 border bg-rose-50 border-rose-300 space-y-1.5';
        box.innerHTML = `
          <div class="text-xs font-extrabold text-rose-700">❌ CHƯA ĐÚNG NGỮ PHÁP: "${esc(capSent)}"</div>
          ${errors.map(er => `<div class="text-xs sm:text-sm text-rose-900">• ${esc(er)}</div>`).join('')}
        `;
      }
    }

    function initPracticePoolsForDay(dayNum) {
      let dayItems = DATA.examples.filter(x => x.day === dayNum);
      let pool = [...dayItems];
      if (pool.length < 100) {
        const others = DATA.examples.filter(x => x.day !== dayNum);
        pool = pool.concat(others.slice(0, 100 - pool.length));
      }
      state.revPool = [...pool];
      state.lisPool = [...pool];
      state.spkPool = [...pool];
      state.revIdx = 0; state.lisIdx = 0; state.spkIdx = 0;
    }

    function renderReverse() {
      if (!state.revPool.length) initPracticePoolsForDay(state.activeDay);
      const item = state.revPool[state.revIdx % state.revPool.length];
      document.getElementById('revCounter').textContent = `${(state.revIdx % state.revPool.length) + 1} / ${state.revPool.length}`;
      document.getElementById('revAnswer').textContent = item.a;
      document.getElementById('revAnswerVi').textContent = item.vi_a;
      document.getElementById('revHintVi').textContent = `Gợi ý nghĩa câu hỏi cần viết: "${item.vi_q}"`;
      document.getElementById('revInput').value = '';
      document.getElementById('revFeedback').classList.add('hidden');
    }

    function checkReverseAnswer() {
      const item = state.revPool[state.revIdx % state.revPool.length];
      const userRaw = document.getElementById('revInput').value.trim();
      const norm = s => s.toLowerCase().replace(/[^a-z0-9'\s]/g, '').split(/\s+/).filter(Boolean);
      const target = norm(item.q);
      const typed = norm(userRaw);
      let ok = 0;
      const htmlWords = target.map((w, i) => {
        if (typed[i] === w || typed.includes(w)) {
          ok++;
          return `<span class="text-emerald-700 font-extrabold">${esc(w)}</span>`;
        }
        return `<span class="text-rose-600 font-bold underline decoration-dotted">${esc(w)}</span>`;
      });
      const pct = target.length ? Math.round((ok / target.length) * 100) : 0;
      const fb = document.getElementById('revFeedback');
      fb.classList.remove('hidden');
      fb.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="font-extrabold ${pct >= 85 ? 'text-emerald-700' : 'text-rose-700'}">${pct >= 85 ? '✅ Tuyệt vời!' : '❌ Chưa khớp hoàn toàn — xem từng từ:'} (${pct}%)</span>
          <button data-speak-text="${esc(item.q)}" data-speak-rate="0.9" class="px-2.5 py-1 rounded-lg bg-indigo-600 text-white text-xs font-bold">🔊 Nghe chuẩn</button>
        </div>
        <div>Đối chiếu: ${htmlWords.join(' ')}?</div>
        <div class="ipa text-xs text-indigo-700">${esc(item.ipa_q)}</div>
      `;
      if (pct < 85) {
        addWrongItem('rev_' + item.id, `Viết câu hỏi cho câu trả lời: "${item.a}" (${item.vi_q})`, [item.q, 'Are you ' + item.q.split(' ').slice(2).join(' '), 'Do you ' + item.q.split(' ').slice(2).join(' ')], 0, `Câu chuẩn: ${item.q}`);
      }
    }

    function renderListen() {
      if (!state.lisPool.length) initPracticePoolsForDay(state.activeDay);
      const item = state.lisPool[state.lisIdx % state.lisPool.length];
      state.lisAnswered = false;
      const blind = document.getElementById('lisBlind').checked;
      const qEl = document.getElementById('lisQText');
      const iEl = document.getElementById('lisQIpa');
      qEl.textContent = item.q;
      iEl.textContent = item.ipa_q;
      qEl.classList.toggle('blur-txt', blind);
      iEl.classList.toggle('blur-txt', blind);

      // Build 3 distractors from other examples
      const others = DATA.examples.filter(x => x.id !== item.id && x.a !== item.a);
      const distractors = [];
      for (let k = 0; k < 3; k++) {
        distractors.push(others[(state.lisIdx * 7 + k * 31) % others.length].a);
      }
      const opts = [item.a, ...distractors];
      // Deterministic shuffle per index
      const rot = state.lisIdx % 4;
      const shuffled = opts.slice(rot).concat(opts.slice(0, rot));
      const correctIdx = shuffled.indexOf(item.a);

      const optBox = document.getElementById('lisOptions');
      optBox.innerHTML = shuffled.map((txt, idx) => `
        <button data-lis-opt="${idx}" data-lis-ans="${correctIdx}" class="text-left px-4 py-3 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-indigo-50 text-sm font-semibold text-slate-800">
          ${String.fromCharCode(65 + idx)}. ${esc(txt)}
        </button>
      `).join('');
      document.getElementById('lisFeedback').classList.add('hidden');
    }

    function renderSpeak() {
