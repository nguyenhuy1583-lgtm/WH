    // ==================== 4-CARD CHUNKED SRS FLASHCARD ENGINE ====================
    const SRS_INTERVAL_DAYS = [0, 1, 3, 7, 14, 30];

    function refillFcBatch(forceReset = false) {
      const raw = (DATA.word_banks && DATA.word_banks[state.wbKey]) || [];
      const now = Date.now();
      if (forceReset) {
        state.fcBatch = [];
        state.fcCursor = 0;
      }
      const inBatch = new Set(state.fcBatch.map(x => x.uid));

      // 1. Prioritize DUE spaced-repetition cards from ANY bank (or current bank first) so past days interleave automatically!
      const allDue = [];
      (DATA.word_bank_meta || []).forEach(m => {
        const arr = (DATA.word_banks && DATA.word_banks[m.id]) || [];
        arr.forEach((item, idx) => {
          const uid = m.id + '_' + idx;
          const rec = state.srsData[uid];
          if (rec && rec.nextDue <= now && !inBatch.has(uid)) {
            allDue.push({ uid, q: item.q, vi: item.vi, ipa: item.ipa, hits: 0, isDue: true, bank: m.short });
          }
        });
      });

      // Pull up to 2 due review cards into the 4-card working batch (interleaving!)
      let dueAdded = 0;
      while (state.fcBatch.length < 4 && allDue.length && dueAdded < 2) {
        const pick = allDue.shift();
        state.fcBatch.push(pick);
        inBatch.add(pick.uid);
        dueAdded++;
      }

      // 2. Fill remaining slots up to 4 with new/unseen cards from the currently selected question-word bank
      for (let idx = 0; idx < raw.length && state.fcBatch.length < 4; idx++) {
        const uid = state.wbKey + '_' + idx;
        if (!inBatch.has(uid) && !state.srsData[uid]) {
          state.fcBatch.push({ uid, q: raw[idx].q, vi: raw[idx].vi, ipa: raw[idx].ipa, hits: 0, isDue: false, bank: state.wbKey.toUpperCase() });
          inBatch.add(uid);
        }
      }

      // 3. If all cards in this bank are already in SRS, pull earliest upcoming cards to practice
      if (state.fcBatch.length < 4) {
        const upcoming = raw.map((item, idx) => {
          const uid = state.wbKey + '_' + idx;
          const rec = state.srsData[uid] || { nextDue: 0 };
          return { uid, q: item.q, vi: item.vi, ipa: item.ipa, hits: 0, isDue: true, nextDue: rec.nextDue, bank: state.wbKey.toUpperCase() };
        }).filter(x => !inBatch.has(x.uid)).sort((a, b) => a.nextDue - b.nextDue);
        while (state.fcBatch.length < 4 && upcoming.length) {
          state.fcBatch.push(upcoming.shift());
        }
      }

      if (state.fcCursor >= state.fcBatch.length) state.fcCursor = 0;
    }

    function renderFlashcardSrs() {
      if (!state.fcBatch.length) refillFcBatch(false);
      const now = Date.now();
      let dueCnt = 0, shortCnt = 0, longCnt = 0;
      Object.values(state.srsData).forEach(rec => {
        if (!rec) return;
        if (rec.nextDue <= now) dueCnt++;
        if (rec.box >= 3) longCnt++;
        else if (rec.box >= 1) shortCnt++;
      });
      document.getElementById('srsDueCnt').textContent = dueCnt;
      document.getElementById('srsActiveCnt').textContent = state.fcBatch.length;
      document.getElementById('srsShortCnt').textContent = shortCnt;
      document.getElementById('srsLongCnt').textContent = longCnt;

      // Render the 4 active slot pills
      const strip = document.getElementById('fcBatchStrip');
      strip.innerHTML = state.fcBatch.map((c, i) => {
        const isCur = i === state.fcCursor;
        const bar = c.hits === 0 ? 'bg-slate-200' : c.hits === 1 ? 'bg-amber-400' : 'bg-emerald-500';
        return `
          <button data-fc-jump="${i}" class="p-2.5 rounded-2xl border text-left transition ${isCur ? 'border-indigo-500 bg-indigo-50 ring-1 ring-indigo-500' : 'border-slate-200 bg-slate-50 hover:bg-white'}">
            <div class="flex items-center justify-between text-[11px] font-extrabold">
              <span class="${c.isDue ? 'text-rose-600' : 'text-indigo-700'}">${c.isDue ? '🔁 Ôn lại' : 'Câu ' + (i + 1)}</span>
              <span class="text-slate-600">${c.hits}/2</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-slate-200 mt-1.5 overflow-hidden">
              <div class="h-full ${bar}" style="width:${c.hits * 50}%"></div>
            </div>
          </button>
        `;
      }).join('');

      const cur = state.fcBatch[state.fcCursor];
      if (!cur) return;
      const rec = state.srsData[cur.uid] || { box: 0 };
      document.getElementById('fcCardTag').textContent = cur.isDue ? `🔁 Ôn ngắt quãng dài hạn (${cur.bank})` : `✨ Câu mới trong cụm 4 câu`;
      document.getElementById('fcCardTag').className = cur.isDue
        ? 'font-extrabold px-2.5 py-1 rounded-full bg-rose-100 text-rose-800'
        : 'font-extrabold px-2.5 py-1 rounded-full bg-indigo-100 text-indigo-800';
      document.getElementById('fcCardBoxLvl').textContent = `Hộp SRS: ${rec.box}/5 · Lượt này: ${cur.hits}/2`;

      const frontEl = document.getElementById('fcFrontText');
      if (state.fcDir === 'listen2en') {
        frontEl.textContent = '🎧 Bấm nút Nghe bên dưới và nhắc lại câu tiếng Anh!';
      } else {
        frontEl.textContent = cur.vi;
      }

      document.getElementById('fcBackEn').textContent = cur.q;
      document.getElementById('fcBackIpa').textContent = cur.ipa;
      document.getElementById('fcBackVi').textContent = cur.vi;

      document.getElementById('fcBack').classList.toggle('hidden', !state.fcFlipped);
      document.getElementById('fcFlipBtn').classList.toggle('hidden', state.fcFlipped);
      document.getElementById('fcGradeBtns').classList.toggle('hidden', !state.fcFlipped);
    }

    function gradeFlashcard(level) {
      const cur = state.fcBatch[state.fcCursor];
      if (!cur) return;
      const now = Date.now();
      if (level === 'again') {
        cur.hits = 0;
        if (state.srsData[cur.uid]) state.srsData[cur.uid].box = 1;
        toast('🔴 Sẽ lặp lại ngay trong cụm 4 câu này!');
      } else if (level === 'hard') {
        cur.hits = Math.min(1, cur.hits + 1);
        toast('🟡 Giữ lại thêm 1 lần nữa trong cụm 4 câu.');
      } else {
        cur.hits++;
        if (cur.hits >= 2) {
          // Graduated from the 4-card working batch -> schedule Spaced Repetition!
          const prevBox = (state.srsData[cur.uid] && state.srsData[cur.uid].box) || 0;
          const newBox = Math.min(5, prevBox + 1);
          const days = SRS_INTERVAL_DAYS[newBox];
          state.srsData[cur.uid] = {
            box: newBox,
            nextDue: now + days * 86400000,
          };
          state.wbMastered.add(cur.uid);
          state.fcBatch.splice(state.fcCursor, 1);
          refillFcBatch(false);
          toast(`🏆 Đã thuộc! Hẹn ôn ngắt quãng sau ${days} ngày (Hộp ${newBox}/5) & đã nạp câu mới.`);
        } else {
          toast('🟢 Tốt! Đúng thêm 1 lần nữa sẽ chuyển vào bộ nhớ dài hạn.');
        }
      }
      // Advance cursor cyclically through the 4 cards
      if (state.fcBatch.length) {
        state.fcCursor = (state.fcCursor + 1) % state.fcBatch.length;
      } else {
        state.fcCursor = 0;
      }
      state.fcFlipped = false;
      saveProg();
      renderFlashcardSrs();
    }

