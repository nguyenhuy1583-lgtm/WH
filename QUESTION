        exp.innerHTML = `❌ Chưa đúng! Đáp án đúng: <strong>${esc(cur.opts[cur.ans])}</strong>. ${esc(cur.exp)} <button data-speak-text="${esc(cur.opts[cur.ans])}" data-speak-rate="0.9" class="ml-2 px-2.5 py-0.5 rounded-lg bg-rose-600 text-white text-xs">🔊 Nghe</button>`;
