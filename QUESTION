    // ==================== MODE 0: 32-FORMULA 1-DAY MASTERY DRILL ====================
    function getCaseByNum(num) {
      return Object.values(DATA.decision_cases || {}).find(c => c.num === num);
    }

    function getRoundNums(roundKey) {
      if (roundKey === '1') return [1,2,3,4,5,6,7,8];
      if (roundKey === '2') return [9,10,11,12,13,14,15,16];
      if (roundKey === '3') return [17,18,19,20,21,22,23,24];
      if (roundKey === '4') return [25,26,27,28,29,30,31,32];
      return Array.from({length: 32}, (_, i) => i + 1);
    }

    function buildDrill32Queue(roundKey) {
      const nums = getRoundNums(roundKey);
      const unmastered = nums.filter(n => (state.drill32Streak[n] || 0) < 3);
      state.d32Queue = unmastered.length ? [...unmastered] : [...nums];
      state.d32CurrentNum = state.d32Queue[0];
      loadDrill32Question(state.d32CurrentNum);
    }

    function loadDrill32Question(num) {
      state.d32CurrentNum = num;
      state.d32Picked = [];
      state.d32Peeked = false;
      const spec = (DATA.drill32_tiles && DATA.drill32_tiles[String(num)]) || { tiles: [], traps: [] };
      const allTiles = [...spec.tiles, ...spec.traps].map((txt, idx) => ({ id: idx, txt }));
      // Fisher-Yates shuffle
      for (let i = allTiles.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [allTiles[i], allTiles[j]] = [allTiles[j], allTiles[i]];
      }
      state.d32Pool = allTiles;
      document.getElementById('d32Feedback').classList.add('hidden');
      document.getElementById('d32CheckBtn').classList.remove('hidden');
      document.getElementById('d32NextBtn').classList.add('hidden');
    }

    function renderDrill32() {
      if (!state.d32Queue.length) buildDrill32Queue(state.d32Round);
      const totalDone = Object.values(state.drill32Streak).filter(v => v >= 3).length;
      document.getElementById('d32MasteredBadge').textContent = `Đã thuộc: ${totalDone} / 32`;

      // Round buttons style
      document.querySelectorAll('.d32-round-btn').forEach(b => {
        const act = b.dataset.d32Round === state.d32Round;
        b.className = act
          ? 'd32-round-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-sm'
          : 'd32-round-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200';
      });

      // 32-Cell Heatmap
      const hm = document.getElementById('d32Heatmap');
      hm.innerHTML = Array.from({length: 32}, (_, i) => {
        const n = i + 1;
        const st = state.drill32Streak[n] || 0;
        const isCur = n === state.d32CurrentNum;
        let cls = 'bg-slate-100 text-slate-500 border-slate-200';
        if (st >= 3) cls = 'bg-emerald-500 text-white border-emerald-600';
        else if (st > 0) cls = 'bg-amber-200 text-amber-900 border-amber-300';
        return `<button data-d32-jump="${n}" title="Trường hợp #${n} (Độ thuộc: ${st}/3)" class="py-1 rounded-lg text-[11px] font-extrabold border ${cls} ${isCur ? 'ring-2 ring-indigo-600' : ''}">${n}</button>`;
      }).join('');

      const c = getCaseByNum(state.d32CurrentNum);
      if (!c) return;
      const curSt = state.drill32Streak[c.num] || 0;
      document.getElementById('d32CaseLabel').textContent = `#${c.num} · ${c.label}`;
      document.getElementById('d32StreakLabel').textContent = curSt >= 3 ? '🏆 ĐÃ THUỘC (3/3)' : `Độ thuộc câu này: ${curSt} / 3 lần liên tiếp`;
      document.getElementById('d32ViPrompt').textContent = `"${c.vi}"`;
      document.getElementById('d32RuleHint').textContent = `Gợi ý ngữ cảnh: ${c.rule}`;

      // Render picked slots
      const slotsEl = document.getElementById('d32Slots');
      if (!state.d32Picked.length) {
        slotsEl.innerHTML = '<span class="text-xs text-slate-400 italic">Chưa chọn mảnh nào — bấm vào các ô màu bên dưới theo đúng thứ tự công thức...</span>';
      } else {
        slotsEl.innerHTML = state.d32Picked.map((t, i) => `
          <button data-d32-unpick="${i}" class="px-2.5 py-1.5 rounded-xl bg-indigo-600 text-white text-xs sm:text-sm font-extrabold hover:bg-rose-600 transition" title="Bấm để bỏ mảnh này">${esc(t.txt)}</button>
        `).join('');
      }

      // Render remaining tile bank
      const pickedIds = new Set(state.d32Picked.map(t => t.id));
      document.getElementById('d32Bank').innerHTML = state.d32Pool.map(t => {
        const used = pickedIds.has(t.id);
        return `<button data-d32-pick="${t.id}" ${used ? 'disabled' : ''} class="px-3 py-2 rounded-xl text-xs sm:text-sm font-bold border transition ${used ? 'bg-slate-100 text-slate-300 border-slate-200 cursor-not-allowed' : 'bg-white text-slate-900 border-slate-300 hover:border-indigo-500 hover:bg-indigo-50 shadow-sm'}">${esc(t.txt)}</button>`;
      }).join('');
    }

    function checkDrill32Answer() {
      const num = state.d32CurrentNum;
      const c = getCaseByNum(num);
      const spec = DATA.drill32_tiles[String(num)];
      const userSeq = state.d32Picked.map(t => t.txt).join(' ');
      const targetSeq = spec.tiles.join(' ');
      const fb = document.getElementById('d32Feedback');
      fb.classList.remove('hidden');

      if (userSeq === targetSeq) {
        if (!state.d32Peeked) {
          state.drill32Streak[num] = Math.min(3, (state.drill32Streak[num] || 0) + 1);
        }
        const st = state.drill32Streak[num] || 0;
        fb.className = 'rounded-2xl p-3.5 text-xs sm:text-sm border bg-emerald-50 border-emerald-300 text-emerald-950 space-y-1';
        fb.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-extrabold text-emerald-800">${st >= 3 ? '🏆 XUẤT SẮC! Bạn đã thuộc 3/3 công thức #' + num + '!' : '✅ CHÍNH XÁC! Chuỗi thuộc: ' + st + '/3'}${state.d32Peeked ? ' (đã xem gợi ý nên không cộng chuỗi)' : ''}</span>
            <button data-speak-text="${esc(c.ex)}" data-speak-rate="0.9" class="px-2.5 py-1 rounded-lg bg-emerald-600 text-white text-xs font-bold">🔊 Nghe ví dụ</button>
          </div>
          <div><strong>Ví dụ chuẩn:</strong> "${esc(c.ex)}" <span class="ipa text-emerald-700">${esc(c.ipa)}</span></div>
          <div class="text-xs text-slate-600">→ ${esc(c.vi)} · <strong>Trả lời:</strong> ${esc(c.ans)}</div>
        `;
        speak(c.ex, 0.9);
        // Move queue forward: if still < 3, re-insert at end of round so it repeats!
        state.d32Queue.shift();
        if (st < 3) state.d32Queue.push(num);
      } else {
        state.drill32Streak[num] = 0;
        fb.className = 'rounded-2xl p-3.5 text-xs sm:text-sm border bg-rose-50 border-rose-300 text-rose-950 space-y-1';
        fb.innerHTML = `
          <div class="font-extrabold text-rose-700">❌ CHƯA ĐÚNG! Chuỗi reset về 0/3 — câu này sẽ lặp lại ngay sau 2 câu nữa!</div>
          <div><strong>Công thức chuẩn:</strong> <span class="font-extrabold text-indigo-900">${esc(targetSeq)}</span></div>
          <div><strong>Ví dụ:</strong> "${esc(c.ex)}" — ${esc(c.vi)}</div>
          <div class="text-xs text-rose-800">⚠️ ${esc(c.avoid)}</div>
        `;
        // Leitner immediate re-queue: put right back 2 positions later!
        state.d32Queue.shift();
        const insertAt = Math.min(2, state.d32Queue.length);
        state.d32Queue.splice(insertAt, 0, num);
      }
      saveProg();
      updateTopStatus();
      document.getElementById('d32CheckBtn').classList.add('hidden');
      document.getElementById('d32NextBtn').classList.remove('hidden');
    }

    function switchTab(tabName) {
