      if (!turn || !fb) return;
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) {
        fb.classList.remove('hidden');
        fb.innerHTML = '<span class="text-amber-700 font-bold">Trình duyệt chưa hỗ trợ Micro chấm phát âm. Mở bằng Chrome/Edge (hoặc MO_TOOL.bat).</span>';
        return;
      }
      stopShPlay();
      const rec = new SR();
      rec.lang = 'en-US';
      rec.interimResults = false;
      fb.classList.remove('hidden');
      fb.innerHTML = '<span class="text-rose-600 font-bold animate-pulse">🎙️ Đang nghe... Hãy đọc to câu này!</span>';
      rec.onresult = (ev) => {
        const spoken = (ev.results[0][0].transcript || '').trim();
        const clean = s => s.toLowerCase().replace(/[^a-z0-9'\s]/g, '').split(/\s+/).filter(Boolean);
        const tw = clean(turn.en);
        const sw = new Set(clean(spoken));
        let hits = 0;
        const colored = tw.map(w => sw.has(w) ? (hits++, `<span class="text-emerald-700 font-extrabold">${esc(w)}</span>`) : `<span class="text-rose-600 font-bold underline">${esc(w)}</span>`);
        const pct = tw.length ? Math.round((hits / tw.length) * 100) : 0;
        fb.innerHTML = `<div class="font-extrabold ${pct >= 80 ? 'text-emerald-700' : 'text-amber-700'}">${pct >= 80 ? '🎉 Chuẩn!' : '💪 Thử đọc rõ hơn:'} (${pct}%)</div><div>Bạn đọc: <em>"${esc(spoken)}"</em></div><div>Chấm từ: ${colored.join(' ')}</div>`;
      };
      rec.onerror = (e) => { fb.innerHTML = `<span class="text-rose-600">Lỗi Micro (${esc(e.error)}).</span>`; };
      try { rec.start(); } catch (e) {}
