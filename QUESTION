"level": 2, "turns": [{"prompt": "Bạn hỏi nhân viên xem tuyến nào đi tới Ga Trung tâm:", "options": ["Which line goes to Central Station?", "Which line does goes to Central Station?", "Where line goes to Central Station?"], "ans": 0, "reply": "Take the Blue Line heading north.", "reply_vi": "Bạn đi Tuyến Xanh hướng về phía bắc."}, {"prompt": "Bạn hỏi chuyến tàu đi hết bao nhiêu điểm dừng:", "options": ["How many stops is it from here?", "How much stops is it from here?", "How long stops is it?"], "ans": 0, "reply": "It is only four stops—about ten minutes.", "reply_vi": "Chỉ có bốn điểm dừng thôi—khoảng mười phút."}, {"prompt": "Bạn hỏi vé một chiều giá bao nhiêu tiền:", "options": ["How much is a one-way ticket?", "How many is a one-way ticket?", "How much does a ticket price?"], "ans": 0, "reply": "It is three dollars. You can tap your card at the gate.", "reply_vi": "Ba đô la. Bạn có thể chạm thẻ tại cổng."}]}, {"id": "rp_13", "title": "13. Khám bệnh tại Phòng khám (Medical Clinic)", "level": 2, "turns": [{"prompt": "Bạn hỏi lễ tân xem mình có cần đặt lịch hẹn trước không:", "options": ["Do I need to make an appointment?", "Am I need to make an appointment?", "Need I to make an appointment?"], "ans": 0, "reply": "Yes, but we have an open slot in twenty minutes.", "reply_vi": "Có, nhưng chúng tôi có một suất trống sau 20 phút nữa."}, {"prompt": "Gặp bác sĩ, bạn hỏi mình nên uống thuốc này mấy lần một ngày:", "options": ["How often should I take this medicine?", "How long should I take this medicine per day?", "How much should I taking this medicine?"], "ans": 0, "reply": "Take one tablet twice a day after meals.", "reply_vi": "Uống một viên hai lần mỗi ngày sau bữa ăn."}, {"prompt": "Bạn hỏi xem mình có cần tránh đồ ăn gì không:", "options": ["Are there any foods I should avoid?", "Is there any foods I should avoid?", "Do there any foods I should avoid?"], "ans": 0, "reply": "Please avoid cold drinks and spicy food for three days.", "reply_vi": "Vui lòng tránh đồ 