a_a": "/aɪ wʊd laɪk tuː lɜːrn ˈbetər prəˌnʌnsiˈeɪʃən/", "vi_q": "Tiếp theo bạn muốn học điều gì?", "vi_a": "Tôi muốn học phát âm tốt hơn.", "level": 3, "cat": "what_which", "day": 2, "task": "Nghe 2 tốc độ → Nói lại đúng ngữ điệu", "topic": "Công nghệ & Tương lai"}, {"id": "qa_0990", "q": "What do you hope your future will be like?", "a": "I hope my future will be peaceful, successful, and happy.", "ipa_q": "/wʌt duː juː hoʊp jʊr ˈfjuːtʃər wɪl biː laɪk/", "ipa_a": "/aɪ hoʊp maɪ ˈfjuːtʃər wɪl biː ˈpiːsfəl səkˈsesfəl ænd ˈhæpi/", "vi_q": "Bạn hy vọng tương lai của mình sẽ như thế nào?", "vi_a": "Tôi hy vọng tương lai của mình sẽ bình yên, thành công và hạnh phúc.", "level": 3, "cat": "what_which", "day": 2, "task": "Nghe 2 tốc độ → Nói lại đúng ngữ điệu", "topic": "Công nghệ & Tương lai"}], "quizzes": [{"id": "qz_01", "day": 1, "vi": "Hỏi đồng nghiệp xem hôm nay họ có mệt không:", "options": ["Do you tired today?", "Are you tired today?", "Is you tired today?", "Did you tired today?"], "ans": 1, "explain": "'Tired' là tính từ → dùng ARE YOU, không dùng DO YOU."}, {"id": "qz_02", "day": 1, "vi": "Hỏi bạn mới quen xem họ có thích uống cà phê không:", "options": ["Are you like coffee?", "Do you like coffee?", "Is you like coffee?", "Does you like coffee?"], "ans": 1, "explain": "'Like' là động từ hành động đi với chủ ngữ 'you' → dùng DO YOU."}, {"id": "qz_03", "day": 1, "vi": "Hỏi tối qua bạn mình có ngủ ngon không:", "options": ["Did you slept well last night?", "Do you sleep well last night?", "Did you sleep well last night?", "Were you sleep well last night?"], "ans": 2, "explain": "Quá khứ có DID → động từ chính quay về nguyên mẫu 'sleep'."}, {"id": "qz_04", "day": 1, "vi": "Xin phép nhân viên thư viện mượn một cuốn sách:", "options": ["Do I borrow this book?", "Can I borrow this book?", "Am I borrow this book?", "Did I borrow this book?"], "ans": 1, "explain": "Xin phép lịch sự/tự nhiên dùng 'Can I + V nguyên mẫu?'."}, {"id": "qz_05", "day": 1, "vi": "Hỏi lễ tân khách sạn xem trong phòng có Wi-Fi miễn phí không:", "options": ["Have free Wi-Fi in the room?", "Is there free Wi-Fi in the room?", "Are there free Wi-Fi?", "Does there free Wi-Fi?"], "ans": 1, "explain": "Hỏi sự tồn tại của cơ sở vật chất (danh từ không đếm được) → 'Is there...?'."}, {"id": "qz_06", "day": 1, "vi": "Ngữ điệu chuẩn khi hỏi câu Yes/No ('Are you ready?') là gì?", "options": ["Xuống giọng ở cuối câu", "Lên giọng ở cuối câu (↗)", "Đọc đều ngang không đổi", "Nhấn mạnh ở giữa rồi tắt"], "ans": 1, "explain": "Câu hỏi Yes/No luôn LÊN GIỌNG ở cuối (↗); câu Wh- thì XUỐNG GIỌNG (↘)."}, {"id": "qz_07", "day": 2, "vi": "Hỏi nghề nghiệp của một người mới gặp:", "options": ["What are you doing?", "What you do?", "What do you do?", "How do you work?"], "ans": 2, "explain": "'What do you do?' là câu chuẩn hỏi nghề nghiệp; 'What are you doing?' là đang làm gì lúc này."}, {"id": "qz_08", "day": 2, "vi": "Hỏi quê hương của bạn mình trông/cảm giác như thế nào:", "options": ["How do you like your hometown?", "What is your hometown like?", "Do you like your hometown?", "Which is your hometown like?"], "ans": 1, "explain": "'What is [S] like?' dùng để hỏi mô tả đặc điểm của nơi chốn/con người."}, {"id": "qz_09", "day": 2, "vi": "Hỏi chọn 1 trong vài tuyến xe buýt đi vào trung tâm:", "options": ["What bus goes downtown?", "Which bus goes downtown?", "Who bus goes downtown?", "How bus goes downtown?"], "ans": 1, "explain": "Chọn trong một tập hợp tuyến xe có sẵn/giới hạn → dùng WHICH."}, {"id": "qz_10", "day": 2, "vi": "Hỏi bạn mình có tận hưởng việc đọc sách không (chú ý ngữ pháp enjoy):", "options": ["Do you enjoy to read books?", "Are you enjoy reading books?", "Do you enjoy reading books?", "Do you enjoy read books?"], "ans": 2, "explain": "Sau ENJOY bắt buộc dùng V-ing (reading), cấm dùng 'enjoy to V'."}, {"id": "qz_11", "day": 2, "vi": "Nhân viên nhà hàng hỏi lịch sự khách muốn uống gì:", "options": ["What do you want drink?", "What would you like to drink?", "What do you enjoy to drink?", "What are you liking to drink?"], "ans": 1, "explain": "'Would you like to + V?' là mẫu lịch sự chuẩn nhất tại nhà hàng."}, {"id": "qz_12", "day": 2, "vi": "Hỏi điều gì khiến bạn mình cảm thấy vui nhất ở chỗ làm:", "options": ["What does make you happy at work?", "What makes you happy at work?", "What is make you happy?", "Why makes you happy?"], "ans": 1, "explain": "'What' làm chủ ngữ → chia thẳng động từ số ít 'makes', không dùng 'does'."}, {"id": "qz_13", "day": 3, "vi": "Hỏi ai là người làm bạn cười nhiều nhất trong gia đình:", "options": ["Who does make you laugh the most?", "Who makes you laugh the most?", "Who is make you laugh?", "Who make you laugh?"], "ans": 1, "explain": "WHO làm chủ ngữ → không mượn do/does, chia thẳng động từ số ít 'makes'."}, {"id": "qz_14", "day": 3, "vi": "Hỏi bạn mình thường đi quán cà phê cùng với ai:", "options": ["Who you visit cafes with?", "Who do you visit cafes with?", "Whose do you visit cafes with?", "Who visits you cafes?"], "ans": 1, "explain": "WHO hỏi tân ngữ → dùng công thức chuẩn Q-A-S-V: Who + do + you + visit ... with?"}, {"id": "qz_15", "day": 3, "vi": "Hỏi cuốn sổ trên bàn là của ai:", "options": ["Who notebook is on the desk?", "Whose notebook is on the desk?", "Which notebook is on the desk?", "Who's notebook is on the desk?"], "ans": 1, "explain": "Hỏi sở hữu dùng 'Whose + Danh từ'."}, {"id": "qz_16", "day": 3, "vi": "Hỏi giờ chính xác bắt đầu lên máy bay tại sân bay:", "options": ["When does boarding begin?", "What time does boarding begin?", "How long does boarding begin?", "How often does boarding begin?"], "ans": 1, "explain": "Hỏi giờ đồng hồ cụ thể ưu tiên dùng 'What time'."}, {"id": "qz_17", "day": 3, "vi": "Hỏi nhân viên sân bay xem làm thủ tục check-in ở đâu:", "options": ["Where I can check in?", "Where can I check in?", "Where do I can check in?", "Where am I check in?"], "ans": 1, "explain": "Đảo trợ động từ CAN lên trước chủ ngữ I: 'Where can I check in?'."}, {"id": "qz_18", "d