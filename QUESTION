<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cẩm nang Đặt câu hỏi Tiếng Anh A1→B2 – Làm chủ trong 7 Ngày</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    html { font-size: 18px; }
    html.fs-md { font-size: 16px; }
    html.fs-lg { font-size: 18px; }
    html.fs-xl { font-size: 20px; }
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; font-size: 1rem; line-height: 1.55; }
    .ipa { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.92rem !important; }
    /* Raise tiny utility sizes so nothing drops below ~12pt (15-16px) */
    .text-\[11px\] { font-size: 0.85rem !important; line-height: 1.4 !important; }
    .text-xs { font-size: 0.92rem !important; line-height: 1.45 !important; }
    .text-sm { font-size: 1rem !important; line-height: 1.5 !important; }
    .text-base { font-size: 1.12rem !important; line-height: 1.5 !important; }
    .text-lg { font-size: 1.25rem !important; line-height: 1.4 !important; }
    .text-xl { font-size: 1.4rem !important; line-height: 1.35 !important; }
    .text-2xl { font-size: 1.65rem !important; line-height: 1.3 !important; }
    .blur-txt { filter: blur(7px); user-select: none; transition: filter 0.2s; }
    .blur-txt:hover { filter: blur(3px); }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">
  <div id="toast" class="fixed bottom-5 right-5 z-50 hidden bg-slate-900 text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl shadow-lg max-w-xs"></div>

  <!-- Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-extrabold text-base shadow-sm shrink-0">7D</div>
        <div class="min-w-0">
          <h1 class="text-sm sm:text-lg font-extrabold text-slate-900 truncate">Cẩm nang Đặt câu hỏi A1→B2 <span class="text-xs font-semibold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full ml-1">7 Ngày</span></h1>
          <p class="text-[11px] sm:text-xs text-slate-500 truncate"><span id="hdrExCount">1025</span> câu IPA + Việt · 40 Quiz · 10 Đóng vai · Ôn 3-Streak</p>
        </div>
      </div>

      <nav class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl overflow-x-auto max-w-full" aria-label="Điều hướng chính">
        <button data-tab="roadmap" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap bg-white text-indigo-700 shadow-sm">🚀 7 Ngày</button>
        <button data-tab="plan30" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">📅 30 Ngày (Người mới)</button>
        <button data-tab="backbone" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">🦴 Xương sống</button>
        <button data-tab="wh" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">🗺️ Từ để hỏi</button>
        <button data-tab="hospital" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">🏥 Lỗi &amp; Từ cùng nghĩa</button>
        <button data-tab="practice" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">🎯 Thực hành</button>
        <button data-tab="wordbank" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">💬 Kho 1.400+ Câu</button>
        <button data-tab="shadowing" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">🎬 45 Hội thoại</button>
        <button data-tab="modals" class="nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap text-slate-600 hover:text-slate-900">🔑 Khuyết thiếu &amp; Đồng nghĩa</button>
      </nav>
    </div>

    <!-- Status Strip -->
    <div class="bg-slate-50 border-t border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="flex flex-wrap items-center gap-2">
          <span class="bg-white border border-slate-200 px-2.5 py-1 rounded-full font-semibold text-slate-700">📅 Đang học: <strong id="topDayLabel" class="text-indigo-700">Ngày 1</strong></span>
          <span class="bg-white border border-slate-200 px-2.5 py-1 rounded-full font-semibold text-slate-700">🔁 Cần ôn (3-streak): <strong id="topReviewCount" class="text-rose-600">0</strong></span>
          <span id="gradBadge" class="hidden bg-emerald-600 text-white px-2.5 py-1 rounded-full font-bold">🎉 Đã hoàn thành khóa 7 ngày</span>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          <div class="inline-flex items-center bg-white border border-slate-300 rounded-lg p-0.5" title="Chỉnh cỡ chữ">
            <button data-fs="fs-md" class="fs-btn px-2 py-0.5 rounded text-xs font-bold text-slate-600 hover:bg-slate-100">12pt</button>
            <button data-fs="fs-lg" class="fs-btn px-2 py-0.5 rounded text-xs font-bold bg-indigo-600 text-white">13.5pt</button>
            <button data-fs="fs-xl" class="fs-btn px-2 py-0.5 rounded text-xs font-bold text-slate-600 hover:bg-slate-100">15pt</button>
          </div>
          <button id="btnExportProg" class="px-2.5 py-1 rounded-lg bg-white border border-slate-300 hover:bg-slate-100 font-semibold text-slate-700">⬇ Sao lưu</button>
          <label class="px-2.5 py-1 rounded-lg bg-white border border-slate-300 hover:bg-slate-100 font-semibold text-slate-700 cursor-pointer">
            ⬆ Khôi phục
            <input id="inpImportProg" type="file" accept=".json" class="hidden" />
          </label>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-5 space-y-5">
    <!-- ==================== TAB 1: 7-DAY ROADMAP ==================== -->
    <section id="tab_roadmap" class="space-y-5">
      <div class="bg-gradient-to-r from-indigo-600 to-indigo-800 text-white rounded-3xl p-5 sm:p-7 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1.5">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-200">Lộ trình thực chiến · 30–45 phút / ngày · Không khóa bài</span>
          <h2 class="text-xl sm:text-2xl font-extrabold">Làm chủ toàn bộ Câu hỏi Tiếng Anh trong 7 ngày</h2>
          <p class="text-xs sm:text-sm text-indigo-100 max-w-2xl">Mỗi ngày gồm: 5 câu ôn hôm trước → Lý thuyết &amp; Mẹo 3 giây → 10 Nghe → 10 Nói chấm điểm → 10 Viết ngược Đáp→Hỏi → 10 Quiz phản xạ. Câu sai tự vào vòng ôn đến khi đúng 3 lần liên tiếp.</p>
        </div>
        <button id="btnStudyToday" class="px-5 py-3.5 rounded-2xl bg-white text-indigo-800 hover:bg-indigo-50 font-extrabold text-sm shadow-md shrink-0">
          🚀 Học hôm nay (Ngày <span id="todayNumBtn">1</span>)
        </button>
      </div>

      <!-- 7 Day Cards -->
      <div id="daysGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3.5"></div>

      <!-- Active Day Workspace -->
      <div id="dayWorkspace" class="bg-white rounded-3xl border border-slate-200 p-5 sm:p-6 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <span id="dwBadge" class="text-xs font-bold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700">Ngày 1 / 7</span>
            <h3 id="dwTitle" class="text-lg font-extrabold text-slate-900 mt-1"></h3>
            <p id="dwSub" class="text-xs sm:text-sm text-slate-600"></p>
          </div>
          <button id="dwMarkDoneBtn" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border border-emerald-300 text-emerald-700 hover:bg-emerald-50">
            ☆ Đánh dấu hoàn thành ngày này
          </button>
        </div>

        <!-- 5 Warm-up Review Questions from Previous Day -->
        <div id="dwWarmupBox" class="hidden bg-amber-50/70 border border-amber-200 rounded-2xl p-4 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold uppercase tracking-wider text-amber-800">🔥 Khởi động: 5 câu ôn lại bài hôm trước</span>
            <span class="text-[11px] text-amber-700">Bấm nghe Chậm / Thường rồi đọc to theo</span>
          </div>
          <div id="dwWarmupList" class="grid grid-cols-1 md:grid-cols-2 gap-2"></div>
        </div>

        <!-- Daily 4-Step Action Buttons -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          <button id="dwGoTheory" class="p-3.5 rounded-2xl bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 text-left">
            <div class="text-xs font-bold text-indigo-700">Bước 1 · Lý thuyết</div>
            <div class="text-sm font-extrabold text-slate-900 mt-0.5">Xem công thức ngày này →</div>
          </button>
          <button id="dwGoListen" class="p-3.5 rounded-2xl bg-sky-50 hover:bg-sky-100 border border-sky-200 text-left">
            <div class="text-xs font-bold text-sky-700">Bước 2 · 10 câu Nghe</div>
            <div class="text-sm font-extrabold text-slate-900 mt-0.5">Nghe chọn đáp án →</div>
          </button>
          <button id="dwGoSpeak" class="p-3.5 rounded-2xl bg-rose-50 hover:bg-rose-100 border border-rose-200 text-left">
            <div class="text-xs font-bold text-rose-700">Bước 3 · 10 câu Nói</div>
            <div class="text-sm font-extrabold text-slate-900 mt-0.5">Chấm phát âm Micro →</div>
          </button>
          <button id="dwGoWriteQuiz" class="p-3.5 rounded-2xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-left">
            <div class="text-xs font-bold text-emerald-700">Bước 4 · Viết &amp; Quiz</div>
            <div class="text-sm font-extrabold text-slate-900 mt-0.5">Viết ngược &amp; Quiz 5s →</div>
          </button>
        </div>

        <!-- Sample Sentences for Selected Day -->
        <div class="space-y-2 pt-2 border-t border-slate-100">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-bold text-slate-900">📌 10 Câu mẫu trọng tâm của ngày này (Nghe Chậm 0.75x &amp; Tự nhiên 1.0x)</h4>
            <button id="dwRefreshSamples" class="text-xs font-semibold text-indigo-600 hover:underline">🔄 Đổi bộ 10 câu khác</button>
          </div>
          <div id="dwSampleList" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
        </div>
      </div>
    </section>

    <!-- ==================== TAB 2: BACKBONE & 12 ERRORS ==================== -->
    <section id="tab_backbone" class="hidden space-y-5">
      <!-- Beginner 1-Minute Symbol Glossary -->
      <div class="bg-white rounded-3xl border border-emerald-200 p-5 sm:p-6 shadow-sm space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-base sm:text-lg font-extrabold text-emerald-950">📖 Bước 0 cho người mới tinh: Hiểu 6 ký hiệu trong 1 phút</h2>
          <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800">Đọc trước khi xem công thức</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 text-xs">
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200"><strong>1. Chủ ngữ (S)</strong> = Người hoặc vật được nhắc tới: <em>I (tôi), you (bạn), he (anh ấy), she (cô ấy), it (nó), we (chúng ta), they (họ)</em>.</div>
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200"><strong>2. Động từ hành động (V)</strong> = Từ chỉ hành động làm được: <em>eat (ăn), go (đi), work (làm), like (thích), sleep (ngủ)</em>.</div>
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200"><strong>3. Tính từ (Adj) &amp; Danh từ (N)</strong> = Cảm xúc/tính chất (<em>tired mệt, hot nóng, big lớn</em>) và tên sự vật (<em>coffee, book, student</em>).</div>
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200"><strong>4. Động từ To-Be (am/is/are · was/were)</strong> = Dùng khi câu <u>không có hành động</u>, chỉ có tính từ/danh từ/nơi chốn (<em>Are you tired?</em>).</div>
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200"><strong>5. Trợ động từ (do/does/did/can/will)</strong> = "Từ mượn" đứng trước chủ ngữ để lập câu hỏi khi có hành động (<em>Do you work?</em>).</div>
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200"><strong>6. V nguyên mẫu · V-ing · V3</strong> = Nguyên gốc (<em>go</em>) · Đuôi -ing (<em>going</em>) · Quá khứ phân từ dùng sau <em>Have you ever</em> (<em>gone/traveled</em>).</div>
        </div>
      </div>

      <!-- Formula Q-A-S-V -->
      <div class="bg-white rounded-3xl border border-slate-200 p-5 sm:p-6 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-extrabold text-slate-900">🦴 Công thức Xương sống Q – A – S – V</h2>
          <span class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-50 text-indigo-700">Áp dụng cho 90% câu hỏi tiếng Anh</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-center">
          <div class="p-3.5 rounded-2xl bg-indigo-50 border border-indigo-200">
            <div class="text-xs font-bold text-indigo-600">Q · Question Word</div>
            <div class="text-base font-extrabold text-slate-900 mt-0.5">Từ để hỏi</div>
            <div class="text-xs text-slate-600 mt-1">What / Where / When / Why / Who / How (bỏ nếu hỏi Yes/No)</div>
          </div>
          <div class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200">
            <div class="text-xs font-bold text-amber-700">A · Auxiliary</div>
            <div class="text-base font-extrabold text-slate-900 mt-0.5">Trợ động từ 🧲</div>
            <div class="text-xs text-slate-600 mt-1">do / does / did / am / is / are / can / will / would</div>
          </div>
          <div class="p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200">
            <div class="text-xs font-bold text-emerald-700">S · Subject</div>
            <div class="text-base font-extrabold text-slate-900 mt-0.5">Chủ ngữ</div>
            <div class="text-xs text-slate-600 mt-1">you / I / he / she / they / the train / your job</div>
          </div>
          <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200">
            <div class="text-xs font-bold text-rose-700">V · Infinitive</div>
            <div class="text-base font-extrabold text-slate-900 mt-0.5">Động từ nguyên mẫu</div>
            <div class="text-xs text-slate-600 mt-1">go / eat / work / like (KHÔNG thêm s/ed sau do/does/did!)</div>
          </div>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3.5 text-xs sm:text-sm text-amber-950">
          <strong>🧲 Mẹo "Nam châm chia thì":</strong> Trợ động từ (<code>does / did / will / can</code>) là cục nam châm đã hút hết phần chia thì. Động từ chính phía sau <strong>LUÔN nguyên mẫu</strong>: <em>Did you <u>go</u>?</em> ✅ (KHÔNG <em>Did you went?</em> ❌).
        </div>
      </div>

      <!-- Interactive 3-Second Decision Flowchart -->
      <div class="bg-white rounded-3xl border border-slate-200 p-5 sm:p-6 shadow-sm space-y-4">
        <h2 class="text-lg font-extrabold text-slate-900">⚡ Sơ đồ Quyết định 3 giây (Bấm chọn để ra công thức ngay)</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="text-xs font-bold text-indigo-700">Bước 1: Muốn hỏi gì?</div>
            <div class="flex flex-col gap-1.5">
              <button data-dec-s1="yesno" class="dec-s1 px-3 py-2 rounded-xl text-xs font-bold text-left bg-indigo-600 text-white">Hỏi Có / Không (Yes/No)</button>
              <button data-dec-s1="wh" class="dec-s1 px-3 py-2 rounded-xl text-xs font-bold text-left bg-white border border-slate-300 text-slate-700">Hỏi thông tin cụ thể (Wh-)</button>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="text-xs font-bold text-indigo-700">Bước 2: Có động từ hành động không?</div>
            <div class="flex flex-col gap-1.5">
              <button data-dec-s2="action" class="dec-s2 px-3 py-2 rounded-xl text-xs font-bold text-left bg-indigo-600 text-white">Có hành động (eat, go, like, work...)</button>
              <button data-dec-s2="state" class="dec-s2 px-3 py-2 rounded-xl text-xs font-bold text-left bg-white border border-slate-300 text-slate-700">Chỉ có tính từ / danh từ / nơi chốn</button>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="text-xs font-bold text-indigo-700">Bước 3: Chọn 1 trong 8 Thì &amp; Sắc thái</div>
            <div class="grid grid-cols-2 gap-1.5">
              <button data-dec-s3="present" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-indigo-600 text-white">Hiện tại</button>
              <button data-dec-s3="now" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-white border border-slate-300 text-slate-700">Đang diễn ra</button>
              <button data-dec-s3="past" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-white border border-slate-300 text-slate-700">Quá khứ</button>
              <button data-dec-s3="future" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-white border border-slate-300 text-slate-700">Tương lai</button>
              <button data-dec-s3="modal" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-white border border-slate-300 text-slate-700">Khả năng / Nên</button>
              <button data-dec-s3="polite" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-white border border-slate-300 text-slate-700">Lịch sự / Xin phép</button>
              <button data-dec-s3="exp" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-white border border-slate-300 text-slate-700">Kinh nghiệm</button>
              <button data-dec-s3="special" class="dec-s3 px-2.5 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold bg-white border border-slate-300 text-slate-700">Phủ định / Đuôi / Giới từ</button>
            </div>
          </div>
        </div>
        <div id="decOutput" class="bg-indigo-50 border border-indigo-200 rounded-2xl p-4 space-y-2.5"></div>
        <div class="pt-1 flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs text-slate-500">Đầy đủ <strong>32 trường hợp (2 × 2 × 8)</strong> bao phủ mọi tình huống đặt câu hỏi A1→B2.</span>
