    function runWbAutoLoop() {
      if (!state.wbAutoPlaying) return;
      if (isFlash) { renderFlashcardSrs(); return; }
      const list = getFilteredWbItems();
      if (!list.length || state.wbAutoIdx >= list.length) {
        stopWbAuto();
        toast('Đã đọc hết danh sách câu của từ này!');
        return;
