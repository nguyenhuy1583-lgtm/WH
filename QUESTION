    function runSpeakMic() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      const fb = document.getElementById('spkFeedback');
      if (!SR) {
        fb.innerHTML = '<span class="text-amber-700 font-bold">Trình duyệt này chưa hỗ trợ Micro chấm phát âm. Hãy mở bằng Chrome/Edge (hoặc dùng MO_TOOL.bat trên Windows).</span>';
        return;
      }
      const item = state.spkPool[state.spkIdx % state.spkPool.length];
      window.speechSynthesis && window.speechSynthesis.cancel();
      const rec = new SR();
      rec.lang = 'en-US';
      rec.interimResults = false;
      fb.innerHTML = '<span class="text-rose-600 font-bold animate-pulse">🎙️ Đang nghe... Hãy đọc to câu hỏi tiếng Anh!</span>';
      rec.onresult = (ev) => {
        const spoken = (ev.results[0][0].transcript || '').trim();
        const clean = s => s.toLowerCase().replace(/[^a-z0-9'\s]/g, '').split(/\s+/).filter(Boolean);
        const tw = clean(item.q);
        const sw = new Set(clean(spoken));
        let hits = 0;
        const colored = tw.map(w => {
          if (sw.has(w)) { hits++; return `<span class="text-emerald-700 font-extrabold">${esc(w)}</span>`; }
          return `<span class="text-rose-600 font-bold underline">${esc(w)}</span>`;
        });
        const pct = tw.length ? Math.round((hits / tw.length) * 100) : 0;
        fb.innerHTML = `
          <div class="space-y-1">
            <div class="flex justify-between font-extrabold">
