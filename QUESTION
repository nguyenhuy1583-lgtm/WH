      const b = document.getElementById('shPlayAllBtn');
      if (b) {
        b.textContent = '▶ Phát cả bài hội thoại';
        b.className = 'px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-extrabold shadow-sm';
      }
      document.querySelectorAll('.sh-turn-card').forEach(el => el.classList.remove('ring-2', 'ring-indigo-600'));
    }

    function getCurrentDialogue() {
      const list = DATA.shadowing_dialogues || [];
      return list.find(d => d.id === state.shCurId) || list[0];
    }

    function playDialogueSequence(startIdx = 0) {
      const dlg = getCurrentDialogue();
      if (!dlg || !state.shPlaying) return;
      if (startIdx >= dlg.turns.length) {
        stopShPlay();
        toast('🎉 Đã phát hết bài hội thoại! Bấm phát lại để Shadowing lần 2 nhé.');
        return;
      }
      state.shActiveTurn = startIdx;
      document.querySelectorAll('.sh-turn-card').forEach((el, i) => {
        el.classList.toggle('ring-2', i === startIdx);
        el.classList.toggle('ring-indigo-600', i === startIdx);
      });
      const turn = dlg.turns[startIdx];
      const rate = parseFloat(document.getElementById('shSpeedSel').value) || 0.9;
      const muteRole = document.getElementById('shMuteRole').value;
      const pauseMs = document.getElementById('shPauseToggle').checked ? 2500 : 700;

      if (muteRole === turn.sp) {
        toast(`🎭 Lượt của bạn (Vai ${turn.sp}): Hãy đọc to câu #${startIdx + 1}!`);
        state.shPlayTimer = setTimeout(() => playDialogueSequence(startIdx + 1), 3800);
        return;
      }
      if (!('speechSynthesis' in window)) {
        stopShPlay();
        return;
      }
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(turn.en);
      u.lang = 'en-US';
      u.rate = rate;
      u.pitch = turn.sp === 'A' ? 1.05 : 0.92;
      u.onend = () => {
        if (!state.shPlaying) return;
        state.shPlayTimer = setTimeout(() => playDialogueSequence(startIdx + 1), pauseMs);
      };
      u.onerror = () => {
        if (!state.shPlaying) return;
        state.shPlayTimer = setTimeout(() => playDialogueSequence(startIdx + 1), 800);
      };
      window.speechSynthesis.speak(u);
    }

