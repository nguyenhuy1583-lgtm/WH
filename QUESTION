    function buildMsQuizPool(cat, doShuffle) {
      const all = DATA.modal_syn_quiz || [];
      let arr = [];
      if (cat === 'modal') arr = all.filter(x => x.cat === 'modal');
      else if (cat === 'syn') arr = all.filter(x => x.cat === 'syn');
      else if (cat === 'wrong') arr = [...state.msQzWrong];
      else if (cat === 'quick10') {
        arr = [...all].sort(() => Math.random() - 0.5).slice(0, 10);
      } else {
        arr = [...all];
      }
      if (doShuffle) arr.sort(() => Math.random() - 0.5);
      state.msQzCat = cat;
      state.msQzPool = arr;
      state.msQzIdx = 0;
      state.msQzScore = 0;
      state.msQzAnswered = false;
    }

