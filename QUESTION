          return `
            <label class="flex items-start gap-2.5 p-2.5 rounded-xl border cursor-pointer transition-colors ${checked ? 'bg-emerald-50/70 border-emerald-200 text-slate-500 line-through' : 'bg-slate-50 border-slate-200 text-slate-800 hover:bg-indigo-50/40'}">
              <input type="checkbox" data-p30-task="${tk}" data-p30-day="${d.day}" class="mt-0.5 w-4 h-4 rounded text-emerald-600 shrink-0" ${checked ? 'checked' : ''} />
              <span class="text-xs sm:text-sm font-semibold leading-snug">${esc(t)}</span>
            </label>`;
        }).join('');

        const actionsHtml = (d.actions || []).map(a => `
          <button data-p30-go-tab="${esc(a.tab)}" data-p30-go-sub="${esc(a.sub || '')}" class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-extrabold shadow-sm">${esc(a.label)} →</button>
        `).join('');

        return `
          <article id="p30_day_${d.day}" class="rounded-3xl border-2 p-5 shadow-sm space-y-3 transition-all ${isDone ? 'bg-emerald-50/40 border-emerald-400' : 'bg-white border-slate-200'}">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold ${isDone ? 'bg-emerald-600 text-white' : 'bg-indigo-600 text-white'}">Ngày ${d.day}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">${esc(weekNames[d.week] || '')}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">⏱ ${esc(d.mins)}</span>
                </div>
                <h3 class="text-base sm:text-lg font-extrabold text-slate-900">${esc(d.title)}</h3>
              </div>
              <button data-p30-toggle="${d.day}" class="px-3 py-1.5 rounded-xl text-xs font-extrabold border transition-colors shrink-0 ${isDone ? 'bg-emerald-600 border-emerald-600 text-white' : 'bg-white border-slate-300 text-slate-700 hover:bg-emerald-50 hover:border-emerald-400'}">${isDone ? '✅ Đã hoàn thành' : '⬜ Tick xong ngày ' + d.day}</button>
            </div>
            <p class="text-xs sm:text-sm text-slate-600">🎯 <strong>Mục tiêu:</strong> ${esc(d.goal)}</p>
            <div class="space-y-2">${taskHtml}</div>
            <div class="rounded-xl border-2 border-amber-400 bg-amber-50 px-3.5 py-2 text-xs sm:text-sm font-extrabold text-amber-950">💡 MẸO NGƯỜI MỚI: ${esc(d.tip)}</div>
            <div class="flex flex-wrap items-center gap-2 pt-1">${actionsHtml}</div>
          </article>`;
      }).join('');
    }

    document.querySelectorAll('.p30-week-btn').forEach(btn => btn.addEventListener('click', () => {
      state.p30Week = btn.dataset.p30Week;
      renderPlan30Tab();
    }));

    document.getElementById('p30CalendarGrid').addEventListener('click', (e) => {
      const b = e.target.closest('[data-p30-jump]');
      if (!b) return;
      const dayNum = Number(b.dataset.p30Jump);
      if (state.p30Week !== 'all') { state.p30Week = 'all'; renderPlan30Tab(); }
      const card = document.getElementById('p30_day_' + dayNum);
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    document.getElementById('p30JumpNext').addEventListener('click', () => {
      const days = DATA.plan30 || [];
      const next = days.find(d => !state.plan30Done.has(d.day)) || days[0];
      if (!next) return;
      if (state.p30Week !== 'all') { state.p30Week = 'all'; renderPlan30Tab(); }
      const card = document.getElementById('p30_day_' + next.day);
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    document.getElementById('p30Cards').addEventListener('change', (e) => {
      const cb = e.target.closest('[data-p30-task]');
      if (!cb) return;
      const tk = cb.dataset.p30Task;
      const dayNum = Number(cb.dataset.p30Day);
      state.plan30Tasks[tk] = cb.checked;
      const dayObj = (DATA.plan30 || []).find(d => d.day === dayNum);
      if (dayObj) {
        const allChecked = dayObj.tasks.every((_, i) => !!state.plan30Tasks[`d${dayNum}_${i}`]);
        if (allChecked) state.plan30Done.add(dayNum);
      }
      saveProg();
      renderPlan30Tab();
    });

    document.getElementById('p30Cards').addEventListener('click', (e) => {
      const tog = e.target.closest('[data-p30-toggle]');
      if (tog) {
        const dayNum = Number(tog.dataset.p30Toggle);
        const dayObj = (DATA.plan30 || []).find(d => d.day === dayNum);
        if (state.plan30Done.has(dayNum)) {
          state.plan30Done.delete(dayNum);
        } else {
          state.plan30Done.add(dayNum);
          if (dayObj) dayObj.tasks.forEach((_, i) => { state.plan30Tasks[`d${dayNum}_${i}`] = true; });
        }
        saveProg();
        renderPlan30Tab();
        return;
      }
      const go = e.target.closest('[data-p30-go-tab]');
      if (go) {
        const targetTab = go.dataset.p30GoTab;
        const targetSub = go.dataset.p30GoSub;
        if (targetTab === 'practice' && targetSub) {
          switchTab('practice');
          const pBtn = document.querySelector(`.pmode-btn[data-pmode="${targetSub}"]`);
          if (pBtn) pBtn.click();
        } else if (targetTab === 'modals' && targetSub) {
          state.msSub = targetSub;
          switchTab('modals');
        } else {
          switchTab(targetTab);
        }
      }
    });

    // Init
    initPracticePoolsForDay(state.activeDay);
    updateTopStatus();
    switchTab('roadmap');
  </script>
</body>
</html>
